{
  "default_roles": {
    "scout": "gemini-4-hydrogen-medium",
    "builder": "gemini-pro-orchestrator-neon",
    "arena_a": "gemini-pro-orchestrator-neon",
    "arena_b": "claude-opus-5-5-medium",
    "interrogator": "claude-opus-5-5-medium",
    "monitor": "gemini-4-hydrogen-low"
  },
  "gates": {
    "stop_hook_mode": "enforce",
    "per_task_deterministic_script": true,
    "dead_code_check": true,
    "interrogator_cadence": "per_dag_phase",
    "max_rejects_before_escalation": 2,
    "escalation_role": "interrogator",
    "allow_comment_tags": [
      "WHY:",
      "INVARIANT:",
      "SAFETY:",
      "NOTE(popododo):"
    ]
  },
  "telemetry": {
    "enabled": true,
    "role_avg_tokens": {
      "scout": 12000,
      "builder": 28000,
      "arena_a": 32000,
      "arena_b": 32000,
      "interrogator": 25000,
      "monitor": 4000
    },
    "anomaly_thresholds": {
      "interrogator_calls_per_phase_warn": 2.0,
      "gate_fail_rate_warn": 0.35,
      "interrogator_history_multiplier_warn": 2.0
    }
  },
  "autopilot": {
    "enabled": true,
    "model": "gemini-decision-1",
    "api_base_url": "https://generativelanguage.googleapis.com/v1beta/decisions",
    "confidence_threshold": 0.65,
    "arena_threshold": 0.7,
    "complexity_min_for_swarm": 2.2,
    "clarification_threshold": 0.9,
    "boundary_plan_threshold": 0.75,
    "context_warn_tokens": 400000,
    "error_loop_threshold": 3,
    "egm_plan_review": true,
    "show_banner": true,
    "timeout_s": 5
  }
}
